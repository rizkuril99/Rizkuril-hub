local function Layout()
    local top = (mode == "mix") and 198 or 166
    Chips.Visible = (mode == "mix")
    Grid.Position = UDim2.fromOffset(0, top)
    Grid.Size = UDim2.new(1, 0, 1, -top)
end

local function UpdateTabColors(m, animated)
    for name, btn in pairs(TabButtons) do
        local active = (name == m)
        local props = {
            BackgroundColor3 = active and Theme.White or Theme.Element,
            TextColor3 = active and Theme.Dark or Theme.Text
        }
        if animated then
            TweenService:Create(btn, TweenInfo.new(0.15), props):Play()
        else
            btn.BackgroundColor3 = props.BackgroundColor3
            btn.TextColor3 = props.TextColor3
        end
    end
end

local function SetMode(m)
    mode = m
    UpdateTabColors(m, true)
    Layout()
    GearPanel.Visible = false

    if m == "emotes" then
        SearchBox.PlaceholderText = "Search emotes — dance, wave..."
    elseif LIST_MODES[m] then
        SearchBox.PlaceholderText = "Filter daftar ini..."
    else
        SearchBox.PlaceholderText = "Search animation packs — ninja, zombie..."
    end

    if LIST_MODES[m] then
        ShowList()
    else
        task.spawn(Fetch, false)
    end
end

for name, btn in pairs(TabButtons) do
    btn.MouseButton1Click:Connect(function()
        if mode == name then return end
        -- bundles <-> mix berbagi daftar yang sama
        local sameList = (mode == "bundles" and name == "mix") or (mode == "mix" and name == "bundles")
        if sameList then
            mode = name
            UpdateTabColors(name, false)
            Layout()
            QueueThumbs()
        else
            SetMode(name)
        end
    end)
end

local function DoSearch(force)
    if LIST_MODES[mode] then
