local function GetChar()
    local c = Player.Character
    return c, c and c:FindFirstChildOfClass("Humanoid")
end

local function GetAnimator()
    local _, hum = GetChar()
    if not hum then return nil end
    return hum:FindFirstChildOfClass("Animator") or Create("Animator", {}, hum)
end

local function IsR6()
    local _, hum = GetChar()
    return hum and hum.RigType == Enum.HumanoidRigType.R6
end

local function LoadAsset(id)
    local ok, res = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
    if ok and res and res[1] then return res[1] end
    local ok2, m = pcall(function() return InsertService:LoadAsset(id) end)
    if ok2 and m then return m end
    return nil
end

local function CollectAnimations(root)
    local list = {}
    if root:IsA("Animation") then table.insert(list, root) end
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("Animation") then table.insert(list, d) end
    end
    return list
end

local function FindCI(parent, name)
    local lname = string.lower(name or "")
    for _, c in ipairs(parent:GetChildren()) do
        if string.lower(c.Name) == lname then return c end
    end
    return nil
end

local function SlotKey(folderName)
    local f = string.lower(folderName or "")
    if string.find(f, "^swim") then return "swim" end
    return f
end

local function CopyTable(t)
    local c = {}
    for k, v in pairs(t) do c[k] = v end
    return c
end

local originals = nil
local function Snapshot(animate)
    if originals then return end
    originals = {}
    for _, d in ipairs(animate:GetDescendants()) do
        if d:IsA("Animation") then originals[d] = d.AnimationId end
    end
end

local function RefreshAnimate(animate)
    local animator = GetAnimator()
    if animator then
        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do t:Stop(0.1) end
    end
    animate.Disabled = true
    task.wait()
    animate.Disabled = false
end

