Track(UIS.InputBegan:Connect(function(input, gp)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    -- merekam tombol hide baru
    if capturing then
        capturing = false
        if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
            Settings.hideKey = input.KeyCode.Name
            SaveSettings()
            SetStatus("Tombol hide diganti ke " .. input.KeyCode.Name)
        end
        refreshHideKey()
        return
    end

    -- merekam tombol hotkey item
    if bindCapture then
        local item = bindCapture
        bindCapture = nil
        if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Unknown then
            SetStatus("Bind dibatalkan")
        elseif input.KeyCode == GetHideKey() then
            SetStatus("Tombol itu dipakai untuk hide GUI, pilih tombol lain")
        else
            Settings.binds[input.KeyCode.Name] = item
            SaveSettings()
            SetStatus(input.KeyCode.Name .. " → " .. tostring(item.name))
            if mode == "keys" then ShowList() end
        end
        return
    end

    if UIS:GetFocusedTextBox() then return end

    if input.KeyCode == GetHideKey() then
        ToggleHidden()
        return
    end

    if gp then return end
    local b = Settings.binds[input.KeyCode.Name]
    if b then
        if b.kind == "emote" and emoteTrack and currentEmoteId == b.id then
            StopEmote() -- tekan lagi = stop
        else
            TriggerItem(b, b.filter)
        end
    end
end))

