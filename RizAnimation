local function ParseId(text)
    text = tostring(text or "")
    local id = string.match(text, "bundles/(%d+)") or string.match(text, "catalog/(%d+)") or string.match(text, "(%d+)")
    return id and tonumber(id) or nil
end

local function DoApply()
    local id = ParseId(IdBox.Text)
    if not id then SetStatus("ID / link tidak valid") return end
    if mode == "emotes" then
        PlayEmote(id)
    else
        ApplyBundle(id, nil, false, CurrentFilter())
    end
end
