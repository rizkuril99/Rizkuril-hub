local pendingThumbs = {}
local thumbQueued = false

local function RegisterThumb(img, url)
    table.insert(pendingThumbs, { img = img, url = url })
end

local function LoadVisibleThumbs()
    if #pendingThumbs == 0 then return end
    local top = Grid.AbsolutePosition.Y
    local bottom = top + Grid.AbsoluteSize.Y
    for i = #pendingThumbs, 1, -1 do
        local t = pendingThumbs[i]
        if not t.img.Parent then
            table.remove(pendingThumbs, i)
        else
            local y = t.img.AbsolutePosition.Y
            if y + 110 >= top - 350 and y <= bottom + 350 then
                t.img.Image = t.url
                table.remove(pendingThumbs, i)
            end
        end
    end
end

function QueueThumbs()
    if thumbQueued then return end
    thumbQueued = true
    task.delay(0.12, function()
        thumbQueued = false
        if alive then LoadVisibleThumbs() end
    end)
end

Track(Grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
    UpdateCells()
    QueueThumbs()
end))

