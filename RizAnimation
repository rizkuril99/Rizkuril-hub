function CheckNew()
    local added = 0
    for _, kind in ipairs({ "bundle", "emote" }) do
        local its = HttpPage(kind, "", NEWEST_SORT, 30, nil)
        if not its then its = AESearch({}, kind, "", NEWEST_SORT, 30, false) end

        if its and #its > 0 then
            local prev = Settings.latest[kind]
            local prevSet = {}
            if prev then
                for _, pid in ipairs(prev) do prevSet[pid] = true end
                for _, it in ipairs(its) do
                    if it.id and not prevSet[it.id] then
                        local key = kind .. ":" .. it.id
                        if not Settings.newItems[key] then
                            Settings.newItems[key] = { id = it.id, name = it.name, kind = kind }
                            added += 1
                        end
                    end
                end
            end
            -- gabung daftar id yang sudah pernah terlihat (maks 400)
            local merged, mset = {}, {}
            for _, it in ipairs(its) do
                if it.id and not mset[it.id] then mset[it.id] = true table.insert(merged, it.id) end
            end
            if prev then
                for _, pid in ipairs(prev) do
                    if #merged >= 400 then break end
                    if not mset[pid] then mset[pid] = true table.insert(merged, pid) end
                end
            end
            Settings.latest[kind] = merged
        end
    end
    SaveSettings()
    RefreshNewBadge()
    if mode == "new" then ShowList() end
    return added
end

task.spawn(function()
    task.wait(3)
    local waited = 0
    local first = true
    while alive do
        if Settings.autoCheck and (first or waited >= REFRESH_MINUTES[Settings.refresh] * 60) then
            first, waited = false, 0
            local ok, n = pcall(CheckNew)
            if ok and n and n > 0 then SetStatus(n .. " item baru di marketplace! (tab NEW)") end
        end
        task.wait(5)
        waited += 5
    end
end)

