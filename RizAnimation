local function HttpPage(kind, keyword, sortIdx, limit, cursorIn)
    local base = (kind == "emote") and EMOTE_QUERY or BUNDLE_QUERY
    local path = string.format("%s?%s&Limit=%d&SortType=%d", CATALOG_PATH, base, limit, SORTS[sortIdx][2])
    if keyword and keyword ~= "" then path = path .. "&Keyword=" .. HttpService:UrlEncode(keyword) end
    if cursorIn then path = path .. "&cursor=" .. HttpService:UrlEncode(cursorIn) end

    local data = CatalogGet(path)
    if not data or not data.data then return nil end

    local items = {}
    for _, it in ipairs(data.data) do
        if it.id then
            local price = it.price
            if price == nil and it.priceStatus == "Free" then price = 0 end
            table.insert(items, { id = it.id, name = it.name, price = price })
        end
    end
    return items, data.nextPageCursor
end

-- jalur cadangan tanpa HTTP: AvatarEditorService:SearchCatalog
local function AESearch(holder, kind, keyword, sortIdx, limit, continue)
    local ok = pcall(function()
        if continue and holder.pages then
            holder.pages:AdvanceToNextPageAsync()
        else
            local params = CatalogSearchParams.new()
            params.SearchKeyword = keyword or ""
            if kind == "emote" then
                params.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
            else
                params.BundleTypes = { Enum.BundleType.Animations }
            end
            pcall(function() params.SortType = Enum.CatalogSortType[AE_SORT_NAMES[sortIdx]] end)
            pcall(function() params.Limit = limit end)
            holder.pages = AvatarEditorService:SearchCatalog(params)
        end
    end)
    if not ok or not holder.pages then return nil end

    local okp, page = pcall(function() return holder.pages:GetCurrentPage() end)
    if not okp or type(page) ~= "table" then return nil end
    local items = {}
    for _, it in ipairs(page) do
        if it.Id then table.insert(items, { id = it.Id, name = it.Name, price = it.Price }) end
    end
    return items, not holder.pages.IsFinished
end

local function PassFilter(it)
    if Settings.freeOnly then return it.price == 0 end
    return true
end

function Fetch(append)
    if LIST_MODES[mode] then return end

    local gen
    if append then
        if loading or not cursor then return end
        gen = fetchGen
    else
        fetchGen += 1
        gen = fetchGen
        cursor = nil
        count = 0
        pageCount = 0
        seen = {}
        ClearGrid()
    end
    loading = true

    local kind = (mode == "emotes") and "emote" or "bundle"
    local q = SearchBox.Text or ""
    local limit = PAGES[Settings.page]
    local sortIdx = Settings.sort
    if not append then lastQueryKey = kind .. ":" .. q end

    Footer.Text = "Loading..."
    local items, nextCursor

    if not (append and source == "ae") then
        local its, nc = HttpPage(kind, q, sortIdx, limit, (append and source == "http") and cursor or nil)
        if its then
            source = "http"
            items, nextCursor = its, nc
        end
    end
    if not items then
        local its, more = AESearch(gridAE, kind, q, sortIdx, limit, append and source == "ae")
        if its then
            source = "ae"
            items = its
            nextCursor = more and "AE" or nil
        end
    end

    if gen ~= fetchGen then return end -- hasil usang, abaikan
    loading = false

    if not items then
        cursor = nil
        Footer.Text = "Gagal load katalog (HTTP & AvatarEditorService tidak tersedia). Pakai kolom ID + APPLY."
        return
    end

    for _, it in ipairs(items) do
        if it.id and not seen[it.id] then
            seen[it.id] = true
            if PassFilter(it) then
                MakeCard(it, kind)
                count += 1
            end
        end
    end
    cursor = nextCursor
    pageCount += 1
    UpdateFooter()
    QueueThumbs()

    -- lanjut otomatis (auto-load semua, atau filter gratis yang hasilnya masih sedikit)
    local wantMore = Settings.autoAll or (Settings.freeOnly and count < 12)
    if wantMore and cursor and pageCount < MAX_AUTO_PAGES then
        task.wait(0.35)
        if alive and gen == fetchGen and not LIST_MODES[mode] then Fetch(true) end
    end
end

