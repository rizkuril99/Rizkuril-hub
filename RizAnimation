local function AddRecent(id, name, kind)
    for i = #Settings.recent, 1, -1 do
        local r = Settings.recent[i]
        if r.id == id and r.kind == kind then table.remove(Settings.recent, i) end
    end
    table.insert(Settings.recent, 1, { id = id, name = name or (kind .. " " .. id), kind = kind })
    while #Settings.recent > MAX_RECENT do table.remove(Settings.recent) end
    SaveSettings()
end

