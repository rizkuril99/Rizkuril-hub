local bundleCache = {} -- id -> { name, anims = { {folder, name, aid} } }
local emoteCache = {}  -- id -> AnimationId string

local function GetBundleEntry(id)
    if bundleCache[id] then return bundleCache[id] end
    local ok, details = pcall(function() return AssetService:GetBundleDetailsAsync(id) end)
    if not ok or not details or not details.Items then return nil, "detail" end

    local anims = {}
    for _, it in ipairs(details.Items) do
        if it.Type == "Asset" then
            local obj = LoadAsset(it.Id)
            if obj then
                for _, a in ipairs(CollectAnimations(obj)) do
                    table.insert(anims, {
                        folder = a.Parent and a.Parent.Name,
                        name = a.Name,
                        aid = a.AnimationId,
                    })
                end
                pcall(function() obj:Destroy() end)
            end
        end
    end
    if #anims == 0 then return nil, "empty" end

    local entry = { name = details.Name, anims = anims }
    bundleCache[id] = entry
    return entry
end

local appliedList = {} -- urutan bundle yang sedang dipakai (dipasang ulang saat respawn)
local applyBusy = false

-- return ok, pesan
local function ApplyBundleSync(id, name, silent, filter)
    if IsR6() then return false, "R6 tidak didukung (bundle ini untuk R15)" end

    local char = GetChar()
    local animate = char and char:FindFirstChild("Animate")
    if not animate then return false, "Script Animate tidak ditemukan (R15 saja)" end

    if not silent then SetStatus("Memuat bundle " .. tostring(name or id) .. "...") end

    local entry, why = GetBundleEntry(id)
    if not entry then
        return false, (why == "empty") and "Bundle tidak berisi animasi / gagal load" or ("Gagal ambil detail bundle " .. tostring(id))
    end

    Snapshot(animate)

    local changed = 0
    for _, a in ipairs(entry.anims) do
        local key = SlotKey(a.folder)
        if (not filter) or filter[key] then
            local folder = a.folder and FindCI(animate, a.folder)
            local target = folder and FindCI(folder, a.name)
            if target and target:IsA("Animation") then
                target.AnimationId = a.aid
                changed += 1
            end
        end
    end

    if changed == 0 then return false, "Tidak ada slot yang cocok di Animate" end

    RefreshAnimate(animate)

    local shownName = name or entry.name
    if not filter then
        appliedList = { { id = id, name = shownName } }
    else
        table.insert(appliedList, { id = id, name = shownName, filter = filter })
        while #appliedList > 20 do table.remove(appliedList, 1) end
    end
    return true, "Applied: " .. tostring(shownName) .. " (" .. changed .. " slot)", shownName
end

local function ApplyBundle(id, name, silent, filter)
    task.spawn(function()
        if applyBusy then SetStatus("Masih memproses bundle sebelumnya...") return end
        applyBusy = true
        local ok, a, b, c = pcall(ApplyBundleSync, id, name, silent, filter)
        applyBusy = false
        if not ok then SetStatus("Error: " .. tostring(a)) return end
        SetStatus(b)
        if a then AddRecent(id, c or name, "bundle") end
    end)
end

local function ReapplyAll()
    if #appliedList == 0 then return end
    applyBusy = true
    local list = appliedList
    appliedList = {}
    for _, e in ipairs(list) do
        pcall(ApplyBundleSync, e.id, e.name, true, e.filter)
    end
    applyBusy = false
end

local function ResetAnimations()
    local char = GetChar()
    local animate = char and char:FindFirstChild("Animate")
    if animate and originals then
        for anim, aid in pairs(originals) do
            if anim.Parent then anim.AnimationId = aid end
        end
        RefreshAnimate(animate)
    end
    appliedList = {}
    SetStatus("Animasi dikembalikan ke default")
end

local emoteTrack, currentEmoteId = nil, nil
local function StopEmote()
    if emoteTrack then
        pcall(function()
            emoteTrack:Stop(0.2)
            emoteTrack:Destroy()
        end)
    end
    emoteTrack, currentEmoteId = nil, nil
end

local function PlayEmote(id, name)
    task.spawn(function()
        if IsR6() then SetStatus("R6 tidak didukung (emote ini untuk R15)") return end
        local animator = GetAnimator()
        if not animator then SetStatus("Karakter tidak ditemukan") return end

        SetStatus("Memuat emote " .. tostring(name or id) .. "...")

        local aid = emoteCache[id]
        if not aid then
            local obj = LoadAsset(id)
            local anim = obj and CollectAnimations(obj)[1]
            if anim and anim.AnimationId ~= "" then
                aid = anim.AnimationId
            else
                aid = "rbxassetid://" .. id -- fallback: anggap ID langsung adalah animation ID
            end
            if obj then pcall(function() obj:Destroy() end) end
            emoteCache[id] = aid
        end

        StopEmote()
        local anim = Create("Animation", { AnimationId = aid })
        local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
        if not ok or not track then SetStatus("Gagal load emote") return end

        track.Priority = Enum.AnimationPriority.Action
        track.Looped = Settings.loop
        emoteTrack, currentEmoteId = track, id
        track:Play(0.2)
        track:AdjustSpeed(Settings.speed)
        track.Stopped:Connect(function()
            if emoteTrack == track then emoteTrack, currentEmoteId = nil, nil end
        end)
        SetStatus("Emote: " .. tostring(name or id))
        AddRecent(id, name or ("Emote " .. id), "emote")
    end)
end

Track(RunService.Heartbeat:Connect(function()
    if not (Settings.stopOnMove and emoteTrack) then return end
    local _, hum = GetChar()
    if hum and hum.MoveDirection.Magnitude > 0.1 then StopEmote() end
end))

