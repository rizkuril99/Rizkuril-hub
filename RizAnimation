local function HttpGetJsonUrl(url)
    local ok, body = pcall(function()
        if httpRequest then
            return httpRequest({ Url = url, Method = "GET" }).Body
        end
        return HttpService:GetAsync(url)
    end)
    if not ok or type(body) ~= "string" then return nil end
    local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
    return ok2 and data or nil
end

-- coba semua host, retry (rate limit dsb)
local function CatalogGet(pathAndQuery)
    for attempt = 1, 3 do
        for _, host in ipairs(CATALOG_HOSTS) do
            local data = HttpGetJsonUrl(host .. pathAndQuery)
            if data and data.data then return data end
        end
        if attempt < 3 then task.wait(1.5 * attempt) end
    end
    return nil
end

